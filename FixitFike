<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>FF — Fike Fix, Vidalia GA</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root {
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    --ink: #465972;
    --blue: #2B4570;
    --blue-deep: #1E3253;
    --brass: #B98B4E;
    --brass-deep: #96702F;
    --paper: #F6F3EC;
    --card: #FFFFFF;
    --slate: #6B7686;
    --line: #DDD8CB;
    --good: #4C6B52;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) { --paper: #14181F; --card: #1B212B; --line: #2B3340; --slate: #9AA3AC; }
  }
  :root[data-theme="dark"] { --paper: #14181F; --card: #1B212B; --line: #2B3340; --slate: #9AA3AC; }
  html { scroll-padding-top: 76px; }
  * , *::before, *::after { box-sizing: border-box; }
  body {
    margin: 0; background: var(--paper); color: var(--ink);
    font-family: "Plus Jakarta Sans", -apple-system, "Helvetica Neue", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  img, svg { max-width: 100%; }
  .mono { font-family: "IBM Plex Mono", ui-monospace, monospace; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 24px; }
  a { color: inherit; }

  /* ---------------- Header ---------------- */
  header {
    position: sticky; top: 0; z-index: 40;
    background: rgba(246,243,236,.92); backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  :root[data-theme="dark"] header { background: rgba(20,24,31,.92); }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) header { background: rgba(20,24,31,.92); }
  }
  header .wrap { display: flex; align-items: center; justify-content: space-between; height: 72px; }
  .brandmark { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .brandmark .monogram {
    width: 42px; height: 42px; border-radius: 10px; background: var(--blue-deep); color: var(--brass);
    display: flex; align-items: center; justify-content: center; flex: none;
    border: 1px solid rgba(185,139,78,.7); box-shadow: inset 0 0 0 3px rgba(255,255,255,.04);
  }
  .brandmark .monogram svg { width: 34px; height: 34px; }
  .brandmark .monogram .board { fill: var(--brass); }
  .brandmark .monogram .trace { fill: none; stroke: var(--blue-deep); stroke-width: 1.15; stroke-linecap: round; stroke-linejoin: round; }
  .brandmark .monogram .screwdriver { fill: #D6AE70; stroke: #6F4D1E; stroke-width: .7; stroke-linejoin: round; }
  .brandmark .monogram .driver-detail { fill: #6F4D1E; }
  .brandmark:hover .monogram { border-color: #D6AE70; box-shadow: inset 0 0 0 3px rgba(255,255,255,.08), 0 3px 12px rgba(30,50,83,.16); }
  .brandmark:focus-visible { outline: 2px solid var(--brass); outline-offset: 4px; border-radius: 11px; }
  .brandmark:focus-visible .monogram { box-shadow: none; }
  .brandmark .word { font-size: 16px; font-weight: 800; color: var(--ink); letter-spacing: -.01em; }
  nav.mainnav { display: flex; align-items: center; gap: 28px; }
  nav.mainnav a {
    font-size: 14px; font-weight: 700; color: var(--slate); text-decoration: none;
  }
  nav.mainnav a:hover { color: var(--blue); }
  .callbtn {
    display: inline-flex; align-items: center; gap: 7px; background: var(--brass); color: #2A1D08;
    font-size: 13.5px; font-weight: 800; padding: 9px 15px; border-radius: 10px; text-decoration: none; white-space: nowrap;
  }
  .callbtn svg { width: 15px; height: 15px; }
  .navlinks-mobile { display: none; }

  /* ---------------- Hero ---------------- */
  .hero {
    position: relative; overflow: hidden;
    background:
      linear-gradient(var(--blue-deep), var(--blue-deep)),
      repeating-linear-gradient(0deg, rgba(255,255,255,.06) 0 1px, transparent 1px 28px),
      repeating-linear-gradient(90deg, rgba(255,255,255,.06) 0 1px, transparent 1px 28px);
    color: #fff;
  }
  .hero .wrap { padding: 76px 24px 84px; display: grid; grid-template-columns: 1.15fr .85fr; gap: 48px; align-items: center; }
  .eyebrow-stamp {
    display: inline-flex; align-items: center; gap: 6px;
    border: 1.4px dashed rgba(185,139,78,.7); color: var(--brass);
    font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 8px; margin-bottom: 18px;
  }
  .eyebrow-stamp svg { width: 13px; height: 13px; }
  .hero h1 { margin: 0 0 16px; font-size: 46px; line-height: 1.08; font-weight: 800; letter-spacing: -.01em; }
  .hero h1 span { color: var(--brass); }
  .hero p.lede { margin: 0 0 28px; font-size: 16.5px; line-height: 1.6; color: #C9D3E0; max-width: 480px; }
  .herobtns { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn {
    display: inline-flex; align-items: center; gap: 8px; border: none; border-radius: 11px;
    padding: 13px 20px; font: inherit; font-size: 14.5px; font-weight: 800; cursor: pointer; text-decoration: none;
  }
  .btn.primary { background: var(--brass); color: #2A1D08; }
  .btn.outline { background: transparent; color: #fff; border: 1.4px solid rgba(255,255,255,.4); }
  .btn svg { width: 16px; height: 16px; }

  .hero-panel {
    background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.16); border-radius: 16px;
    padding: 22px;
  }
  .hero-panel .row { display: flex; justify-content: space-between; align-items: baseline; padding: 11px 0; border-bottom: 1px solid rgba(255,255,255,.14); }
  .hero-panel .row:last-child { border-bottom: none; }
  .hero-panel .lab { font-size: 13px; color: #AEC0DA; font-weight: 600; }
  .hero-panel .val { font-size: 14px; font-weight: 800; color: #fff; }
  .hero-panel .tk { font-size: 11px; color: #8FA3BE; }

  /* ---------------- Sections ---------------- */
  section { padding: 72px 0; }
  .section-head { max-width: 560px; margin-bottom: 40px; }
  .section-head .kicker { font-size: 12.5px; font-weight: 800; color: var(--brass-deep); margin: 0 0 8px; }
  .section-head h2 { font-size: 30px; font-weight: 800; margin: 0 0 10px; letter-spacing: -.01em; }
  .section-head p { font-size: 15px; color: var(--slate); line-height: 1.6; margin: 0; }

  .services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .svc-card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 22px; }
  .svc-card .badge {
    width: 44px; height: 44px; border-radius: 11px; border: 1.5px solid var(--blue); color: var(--blue);
    display: flex; align-items: center; justify-content: center; margin-bottom: 14px;
  }
  .svc-card .badge svg { width: 22px; height: 22px; }
  .svc-card h3 { margin: 0 0 6px; font-size: 15.5px; font-weight: 800; }
  .svc-card p { margin: 0; font-size: 13.5px; color: var(--slate); line-height: 1.55; }

  .why-strip { background: var(--card); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .why-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .why-item .num { font-family: "IBM Plex Mono", monospace; font-size: 12.5px; font-weight: 700; color: var(--brass-deep); margin-bottom: 10px; display: block; }
  .why-item h3 { margin: 0 0 8px; font-size: 17px; font-weight: 800; }
  .why-item p { margin: 0; font-size: 13.5px; color: var(--slate); line-height: 1.6; }

  .quote-band {
    background: var(--ink); color: #fff; border-radius: 18px;
    padding: 46px 40px; display: flex; align-items: center; justify-content: space-between; gap: 28px; flex-wrap: wrap;
  }
  .quote-band h2 { margin: 0 0 6px; font-size: 24px; font-weight: 800; }
  .quote-band p { margin: 0; font-size: 14px; color: #B9C2CC; }
  .quote-band .actions { display: flex; gap: 10px; flex: none; }
  .btn.light { background: #fff; color: var(--ink); }

  footer { border-top: 1px solid var(--line); padding: 40px 0 34px; }
  footer .wrap { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  footer .col h4 { margin: 0 0 10px; font-size: 12.5px; font-weight: 800; color: var(--slate); text-transform: uppercase; letter-spacing: .04em; }
  footer .col div { font-size: 13.5px; color: var(--ink); line-height: 1.7; }
  footer .col a { text-decoration: none; }
  footer .wink { margin-top: 26px; padding-top: 20px; border-top: 1px solid var(--line); font-size: 12px; color: var(--slate); }

  @media (max-width: 860px) {
    .hero .wrap { grid-template-columns: 1fr; }
    .hero h1 { font-size: 36px; }
    .services-grid { grid-template-columns: repeat(2, 1fr); }
    .why-grid { grid-template-columns: 1fr; gap: 26px; }
    nav.mainnav a { display: none; }
    .quote-band { padding: 32px 24px; }
  }
  @media (max-width: 560px) {
    .services-grid { grid-template-columns: 1fr; }
    .hero .wrap { padding: 56px 20px 64px; }
    section { padding: 52px 0; }
  }
</style>
</head>
<body>

<header>
  <div class="wrap">
    <a class="brandmark" href="#top">
      <span class="monogram" aria-label="Fike Fix computer mark">
        <svg viewBox="0 0 40 40" role="img" aria-hidden="true">
